# ==============================================================================
# Koket Bakery & Pastry - Frontend Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development or customize for production:
#   cp .env.local.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Configuration
# ------------------------------------------------------------------------------
# Production Deployed Backend:
# Note: The backend CORS whitelist permits requests originating from http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://backend.koket-bakery.com/api/v1

# Local Development Backend (uncomment to use local backend):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1

# ------------------------------------------------------------------------------
# 2. Asset & Image URLs
# ------------------------------------------------------------------------------
# Base URL for static uploads (products, user avatars, receipts, etc.)
# Production Deployed Assets:
NEXT_PUBLIC_IMAGE_BASE_URL=https://backend.koket-bakery.com
NEXT_PUBLIC_ASSET_BASE_URL=https://backend.koket-bakery.com

# Local Development Assets (uncomment to use local backend):
# NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:5001
# NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Port for the frontend Next.js server (defaults to 3000)
PORT=3000
